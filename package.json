{
  "name": "eva-http",
  "version": "1.0.0",
  "description": "A lightweight HTTP framework for Bun, built from scratch",
  "author": {
    "name": "Alex Bellosta",
    "email": "abellostabuiza@gmail.com",
    "url": "https://github.com/Albebu"
  },
  "type": "module",
  "main": "src/eva.ts",
  "scripts": {
    "dev": "bun run --watch server.ts",
    "build": "bun build server.ts --target=bun --outdir=dist --minify",
    "start": "bun dist/server.js",
    "build:lib": "bun build src/eva.ts --target=browser --outdir=dist",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "typescript": "^5"
  },
  "keywords": [
    "http",
    "framework",
    "bun",
    "server",
    "router",
    "middleware"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:Albebu/Eva.git"
  }
}
